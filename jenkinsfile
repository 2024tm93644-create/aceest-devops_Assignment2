pipeline {
    agent any

    stages {

        stage('Clone Code') {
            steps {
                git 'https://github.com/2024tm93644-create/aceest-devops_Assignment2.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'pytest'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t aceest-app:v1 .'
            }
        }
    }
}